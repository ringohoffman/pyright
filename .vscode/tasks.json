{
    "version": "2.0.0",
    "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
    },
    "tasks": [
        {
            "label": "Build pyright-internal",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/packages/pyright-internal"
            },
            "group": "build",
            "problemMatcher": "$tsc"
        },
        {
            "label": "Watch pyright-internal",
            "type": "shell",
            "command": "npm run build -- --watch",
            "options": {
                "cwd": "${workspaceFolder}/packages/pyright-internal"
            },
            "isBackground": true,
            "problemMatcher": "$tsc-watch"
        },
        {
            "label": "Build Pyright type server",
            "type": "shell",
            "command": "npm run webpack",
            "options": {
                "cwd": "${workspaceFolder}/packages/pyright-typeserver"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Watch Pyright type server",
            "type": "shell",
            "command": "npm run webpack -- --watch",
            "options": {
                "cwd": "${workspaceFolder}/packages/pyright-typeserver"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(ERROR|WARNING) in (.*)$",
                    "severity": 1,
                    "file": 2,
                    "message": 0
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "PublicPath:",
                    "endsPattern": "Rspack compiled in"
                }
            }
        },
        {
            "label": "Watch extension",
            "type": "npm",
            "script": "watch:extension",
            "isBackground": true,
            "presentation": {
                "clear": true
            },
            // From vscode-tsl-problem-matcher.
            "problemMatcher": {
                "owner": "pyright-extension-watch",
                "fileLocation": "absolute",
                "pattern": [
                    {
                        "regexp": "\\[tsl\\] (ERROR|WARNING) in (.*)?\\((\\d+),(\\d+)\\)",
                        "severity": 1,
                        "file": 2,
                        "line": 3,
                        "column": 4
                    },
                    {
                        "regexp": "\\s*TS(\\d+):\\s*(.*)$",
                        "code": 1,
                        "message": 2
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": {
                        "regexp": "PublicPath: .*?"
                    },
                    "endsPattern": {
                        "regexp": "(?:Rspack|webpack) compiled in .*? m?s"
                    }
                }
            }
        },
        {
            "label": "Watch test server",
            "type": "npm",
            "script": "watch:testserver",
            "isBackground": true,
            // From vscode-tsl-problem-matcher.
            "problemMatcher": {
                "owner": "custom",
                "fileLocation": "absolute",
                "pattern": [
                    {
                        "regexp": "\\[tsl\\] (ERROR|WARNING) in (.*)?\\((\\d+),(\\d+)\\)",
                        "severity": 1,
                        "file": 2,
                        "line": 3,
                        "column": 4
                    },
                    {
                        "regexp": "\\s*TS(\\d+):\\s*(.*)$",
                        "code": 1,
                        "message": 2
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": {
                        "regexp": "PublicPath: .*?"
                    },
                    "endsPattern": {
                        "regexp": "webpack compiled in .*? ms"
                    }
                }
            }
        }
    ]
}
